# =============================================================================
# AI Email Threat Detection Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All services have mock fallbacks - the app runs without any real keys.
# =============================================================================

# --- Database ---
# Default: SQLite (file-based, zero-config)
# For PostgreSQL: postgresql+aiosqlite://user:pass@localhost:5432/email_forensics
DATABASE_URL=sqlite+aiosqlite:///./email_forensics.db

# --- Neo4j (Optional - defaults to NetworkX in-memory) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_ENABLED=false

# --- MaxMind GeoIP (Optional - mock fallback available) ---
# Download GeoLite2-City.mmdb from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# --- AbuseIPDB (Optional - mock fallback available) ---
# Get your API key from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=92ddc7bda2cfa224940bc2a6696ca91f5e889d4f57160b02f8eaafc7eb78c37240b674b22cac499a

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
